generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum AdminRole {
  SUPERADMIN
  ADMIN
  EDITOR
}

enum ContentStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum SubmissionStatus {
  NEW
  CONTACTED
  IN_PROGRESS
  CLOSED
}

enum ProjectType {
  REFERENCE
  CAPACITY_SOLUTION
}

model AdminUser {
  id           String    @id @default(cuid())
  name         String
  email        String    @unique
  passwordHash String
  role         AdminRole @default(EDITOR)
  active       Boolean   @default(true)
  lastLoginAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  sessions Session[]

  @@index([role])
}

model Session {
  id           String    @id @default(cuid())
  adminUserId  String
  tokenHash    String    @unique
  expiresAt    DateTime
  createdAt    DateTime  @default(now())

  adminUser AdminUser @relation(fields: [adminUserId], references: [id], onDelete: Cascade)

  @@index([adminUserId])
  @@index([expiresAt])
}

model ProductCategory {
  id        String   @id @default(cuid())
  slug      String   @unique
  image     String?
  icon      String?
  sortOrder Int      @default(0)
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  translations ProductCategoryTranslation[]
  products     Product[]

  @@index([active])
  @@index([sortOrder])
}

model ProductCategoryTranslation {
  id              String @id @default(cuid())
  categoryId      String
  locale          String

  name            String
  shortDescription String?
  description     String?
  seoTitle        String?
  seoDescription  String?

  category ProductCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  /// Dile özgü URL parçası (i18n). Boşsa o dilde sayfa yok.
  slug String?

  @@unique([categoryId, locale])
  @@unique([locale, slug])
  @@index([locale])
}

model Product {
  id          String        @id @default(cuid())
  categoryId  String
  slug        String        @unique
  sku         String?
  coverImage  String?
  coverImageAlt String?
  videoUrl    String?
  sortOrder   Int           @default(0)
  featured    Boolean       @default(false)
  active      Boolean       @default(true)
  status      ContentStatus @default(DRAFT)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  category      ProductCategory        @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  translations  ProductTranslation[]
  images        ProductImage[]
  specifications ProductSpecification[]
  documents     ProductDocument[]
  quoteRequests QuoteRequest[]
  relatedProjects Project[]  @relation("ProductToProject")
  relatedPosts    BlogPost[] @relation("ProductToBlogPost")

  @@index([categoryId])
  @@index([status])
  @@index([featured])
  @@index([createdAt])
}

model ProductTranslation {
  id          String  @id @default(cuid())
  productId   String
  locale      String

  name             String
  shortDescription String?
  description      String?
  applications     String?
  features         String?

  seoTitle       String?
  seoDescription String?
  canonicalUrl   String?
  ogImage        String?

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  /// Dile özgü URL parçası (i18n). Boşsa o dilde sayfa yok.
  slug String?

  /// Kapak + galeri görselleri için dile özgü açıklayıcı alt metni (Google Images/erişilebilirlik).
  /// Boşsa render katmanı `name`'e düşer; hiçbir zaman başka dilin (Türkçe) alt metnini göstermez.
  imageAlt String?

  @@unique([productId, locale])
  @@unique([locale, slug])
  @@index([locale])
}

model ProductImage {
  id        String   @id @default(cuid())
  productId String
  imageUrl  String
  alt       String?
  caption   String?
  width     Int?
  height    Int?
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
}

model ProductSpecification {
  id        String @id @default(cuid())
  productId String
  locale    String
  label     String
  value     String
  sortOrder Int    @default(0)

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId, locale])
}

model ProductDocument {
  id        String   @id @default(cuid())
  productId String
  title     String
  fileUrl   String
  mimeType  String
  fileSize  Int
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
}

model Project {
  id         String        @id @default(cuid())
  slug       String        @unique
  type       ProjectType   @default(REFERENCE)
  country    String
  city       String?
  capacity   String?
  area       String?
  coverImage String?
  coverImageAlt String?
  videoUrl   String?
  sortOrder  Int           @default(0)
  featured   Boolean       @default(false)
  status     ContentStatus @default(DRAFT)
  publishedAt DateTime?
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt

  translations    ProjectTranslation[]
  images          ProjectImage[]
  relatedProducts Product[]  @relation("ProductToProject")
  relatedPosts    BlogPost[] @relation("ProjectToBlogPost")

  @@index([status])
  @@index([featured])
  @@index([country])
  @@index([publishedAt])
  @@index([type])
}

model ProjectTranslation {
  id        String @id @default(cuid())
  projectId String
  locale    String

  name             String
  shortDescription String?
  description      String?

  seoTitle       String?
  seoDescription String?
  ogImage        String?

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  /// Dile özgü URL parçası (i18n). Boşsa o dilde sayfa yok.
  slug String?

  @@unique([projectId, locale])
  @@unique([locale, slug])
  @@index([locale])
}

model ProjectImage {
  id        String   @id @default(cuid())
  projectId String
  imageUrl  String
  alt       String?
  caption   String?
  width     Int?
  height    Int?
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
}

model BlogCategory {
  id        String   @id @default(cuid())
  slug      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  translations BlogCategoryTranslation[]
  posts        BlogPost[]
}

model BlogCategoryTranslation {
  id         String @id @default(cuid())
  categoryId String
  locale     String

  name        String
  description String?

  category BlogCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  /// Dile özgü URL parçası (i18n). Boşsa o dilde sayfa yok.
  slug String?

  @@unique([categoryId, locale])
  @@unique([locale, slug])
  @@index([locale])
}

model BlogTag {
  id   String @id @default(cuid())
  slug String @unique
  /// Görünen ad (Türkçe karakterli); eski kayıtlarda boş olabilir, o zaman slug'dan üretilir.
  name String?

  posts BlogPost[]
}

model BlogPost {
  id          String        @id @default(cuid())
  slug        String        @unique
  categoryId  String?

  coverImage  String?
  coverImageAlt String?
  authorType  String        @default("company")
  authorName  String?

  status      ContentStatus @default(DRAFT)
  featured    Boolean       @default(false)

  publishedAt DateTime?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  category     BlogCategory?            @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  translations BlogPostTranslation[]
  tags         BlogTag[]
  relatedProducts Product[] @relation("ProductToBlogPost")
  relatedProjects Project[] @relation("ProjectToBlogPost")

  @@index([categoryId])
  @@index([status])
  @@index([featured])
  @@index([publishedAt])
}

model BlogPostTranslation {
  id         String @id @default(cuid())
  blogPostId String
  locale     String

  title   String
  excerpt String?
  content String?

  seoTitle       String?
  seoDescription String?
  canonicalUrl   String?
  ogImage        String?

  blogPost BlogPost @relation(fields: [blogPostId], references: [id], onDelete: Cascade)

  /// Dile özgü URL parçası (i18n). Boşsa o dilde sayfa yok.
  slug String?

  @@unique([blogPostId, locale])
  @@unique([locale, slug])
  @@index([locale])
}

model Page {
  id        String        @id @default(cuid())
  slug      String        @unique
  pageType  String        @default("standard")
  status    ContentStatus @default(DRAFT)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  translations PageTranslation[]

  @@index([status])
}

model PageTranslation {
  id     String @id @default(cuid())
  pageId String
  locale String

  title   String
  content String?

  seoTitle       String?
  seoDescription String?
  ogImage        String?

  page Page @relation(fields: [pageId], references: [id], onDelete: Cascade)

  /// Dile özgü URL parçası (i18n). Boşsa o dilde sayfa yok.
  slug String?

  @@unique([pageId, locale])
  @@unique([locale, slug])
  @@index([locale])
}

model Media {
  id           String   @id @default(cuid())
  filename     String
  originalName String
  mimeType     String
  url          String
  storageKey   String   @unique
  alt          String?
  caption      String?
  width        Int?
  height       Int?
  fileSize     Int
  sourceUrl    String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([sourceUrl])

  @@index([createdAt])
}

model ContactSubmission {
  id      String           @id @default(cuid())
  name    String
  company String?
  email   String
  phone   String?
  country String?
  subject String?
  message String
  status  SubmissionStatus @default(NEW)

  createdAt DateTime @default(now())

  @@index([status])
  @@index([createdAt])
}

model QuoteRequest {
  id String @id @default(cuid())

  name    String
  company String
  email   String
  phone   String
  country String

  productId   String?
  projectType String?
  capacity    String?

  message String

  status    SubmissionStatus @default(NEW)
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  product Product? @relation(fields: [productId], references: [id], onDelete: SetNull)

  @@index([status])
  @@index([createdAt])
  @@index([productId])
}

model SiteSetting {
  id        String   @id @default(cuid())
  key       String   @unique
  value     String
  type      String   @default("string")
  updatedAt DateTime @updatedAt
}

model Redirect {
  id              String   @id @default(cuid())
  sourcePath      String   @unique
  destinationPath String
  statusCode      Int      @default(301)
  active          Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([active])
}

model NavigationItem {
  id       String  @id @default(cuid())
  parentId String?
  location String
  label    String
  url      String
  sortOrder Int    @default(0)
  active   Boolean @default(true)

  parent   NavigationItem?  @relation("NavigationItemChildren", fields: [parentId], references: [id], onDelete: Cascade)
  children NavigationItem[] @relation("NavigationItemChildren")

  @@index([location])
  @@index([parentId])
}

/// Ana sayfa hero slaytları (Admin > İçerik > Slider). Hiç aktif slayt yoksa site varsayılan slaytları gösterir.
model HeroSlide {
  id         String   @id @default(cuid())
  title      String
  subtitle   String?
  buttonText String
  buttonLink String
  image      String
  imageAlt   String?
  /// "cover": fotoğraf sağ yarıyı doldurur; "contain": ürün görseli kırpılmadan gösterilir
  fit        String   @default("cover")
  sortOrder  Int      @default(0)
  active     Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([active, sortOrder])
}
