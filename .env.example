DATABASE_URL=
DIRECT_URL=
# Production: https://www.mezbahateknolojileri.com (kanonik origin; BUILD sırasında gömülür, değişirse yeniden build).
# Yerel geliştirme için .env dosyasında http://localhost:3000 kullanın; production build localhost/http kabul etmez.
NEXT_PUBLIC_SITE_URL=https://www.mezbahateknolojileri.com
AUTH_SECRET=

# Google Ads taban etiketi (gtag.js). Boşsa hiçbir şey yüklenmez — bkz. src/components/analytics/google-ads-tag.tsx
NEXT_PUBLIC_GOOGLE_ADS_ID=AW-946234179

# Not: kodda yalnızca STORAGE_PROVIDER okunur ("local" tek destekli değer); diğer STORAGE_* şimdilik kullanılmıyor.
STORAGE_PROVIDER=local
STORAGE_ENDPOINT=
STORAGE_REGION=
STORAGE_BUCKET=
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
STORAGE_PUBLIC_URL=

SEED_ADMIN_EMAIL=
# dotenv `#` karakterini yorum başlangıcı sayar - şifrede # geçiyorsa değeri tırnak içine alın
SEED_ADMIN_PASSWORD=
