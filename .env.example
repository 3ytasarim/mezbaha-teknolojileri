DATABASE_URL=
DIRECT_URL=
# Production: https://www.mezbahateknolojileri.com (kanonik origin; BUILD sırasında gömülür, değişirse yeniden build).
# Yerel geliştirme için .env dosyasında http://localhost:3000 kullanın; production build localhost/http kabul etmez.
NEXT_PUBLIC_SITE_URL=https://www.mezbahateknolojileri.com
AUTH_SECRET=

# Google Ads taban etiketi (gtag.js). Boşsa hiçbir şey yüklenmez — bkz. src/components/analytics/google-ads-tag.tsx
NEXT_PUBLIC_GOOGLE_ADS_ID=AW-946234179

# Google Tag Manager. Boşsa hiçbir şey yüklenmez — bkz. src/components/analytics/google-tag-manager.tsx
NEXT_PUBLIC_GTM_ID=GTM-MLL6PWVC

# İletişim/Teklif Al formu bildirim e-postası (bkz. src/lib/mail.ts). Eksikse e-posta gönderilmez, form yine
# de veritabanına kaydedilir (Admin > Talepler). Hostinger için: SMTP_HOST=smtp.hostinger.com, SMTP_PORT=465.
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
CONTACT_NOTIFY_EMAIL=fatih@mezbahateknolojileri.com

# Not: kodda yalnızca STORAGE_PROVIDER okunur ("local" tek destekli değer); diğer STORAGE_* şimdilik kullanılmıyor.
STORAGE_PROVIDER=local
STORAGE_ENDPOINT=
STORAGE_REGION=
STORAGE_BUCKET=
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
STORAGE_PUBLIC_URL=

SEED_ADMIN_EMAIL=
# dotenv `#` karakterini yorum başlangıcı sayar - şifrede # geçiyorsa değeri tırnak içine alın
SEED_ADMIN_PASSWORD=
